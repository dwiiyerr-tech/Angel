TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# Signal server — contact maintainer for access
SIGNAL_SERVER_URL=https://api.thecharon.xyz/api
SIGNAL_SERVER_KEY=
SIGNAL_POLL_MS=30000

# Helius RPC — required for live execution; free tier works for dry_run
HELIUS_API_KEY=
SOLANA_RPC_URL=
SOLANA_WS_URL=

# GMGN enrichment — set GMGN_ENABLED=false to skip (falls back to Jupiter data)
GMGN_ENABLED=true
GMGN_API_KEY=
GMGN_REQUEST_DELAY_MS=2500
GMGN_MAX_RETRIES=2
GMGN_CACHE_TTL_MS=300000

# Angel Manager read-only GMGN CLI research gateway.
# Install separately on the host: npm install -g gmgn-cli
# The Manager allowlist contains only market/token read commands; swap/cooking/sign/broadcast are blocked.
GMGN_MANAGER_ENABLED=true
GMGN_CLI_BIN=gmgn-cli
GMGN_MANAGER_TIMEOUT_MS=12000

DB_PATH=./angel.sqlite
MIN_EXECUTABLE_POSITION_SOL=0.001
MIN_OPPORTUNITY_SIZE_MULTIPLIER=0.35
FRESH_GMGN_BUDGET_MS=1200
TRADING_MODE=dry_run

# Live / confirm execution — wallet + Jupiter API key required
# SOLANA_PRIVATE_KEY and PRIVATE_KEY are both read; set SOLANA_PRIVATE_KEY.
SOLANA_PRIVATE_KEY=
PRIVATE_KEY=
JUPITER_API_KEY=
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v2
JUPITER_SLIPPAGE_BPS=300
MIN_RISK_REWARD_RATIO=1.5
TP1_R_MULTIPLE=1
RISK_PER_TRADE_SOL=0.02
SECOND_WAVE_MAX_HOLD_MS=5400000
SECOND_WAVE_SIDEWAYS_TIMEOUT_MINUTES=30
SECOND_WAVE_TIME_TIGHTEN_ENABLED=true
MIN_SECOND_WAVE_SCORE=8
LOSS_STREAK_SIZE_CUT_AFTER=2
LOSS_STREAK_SIZE_MULTIPLIER=0.5
LOSS_STREAK_PAUSE_AFTER=3
LOSS_STREAK_PAUSE_MS=1800000
# Optional Jito MEV-protected broadcast for live swaps. Keep false for dry-run.
JITO_ENABLED=false
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_BUNDLE_ONLY=false
LIVE_MIN_SOL_RESERVE=0.02
# Independent hard caps; strategy/LLM settings cannot exceed these.
LIVE_MAX_POSITION_SOL=0.1
LIVE_MAX_WALLET_FRACTION=0.1
LIVE_MAX_OPEN_POSITIONS=2
LIVE_MAX_TOTAL_EXPOSURE_SOL=0.2
LIVE_MAX_DAILY_ENTRIES=5
LIVE_MAX_DAILY_LOSS_SOL=0.1

# LLM — any OpenAI-compatible endpoint; MiniMax M2.7 is the default
ENABLE_LLM=true
LLM_BASE_URL=https://api.minimax.io/v1
LLM_API_KEY=
LLM_MODEL=MiniMax-M2.7
LLM_TIMEOUT_MS=60000
LLM_CANDIDATE_PICK_COUNT=10
LLM_CANDIDATE_MAX_AGE_MS=120000

# LLM fallback — used when the primary endpoint errors or times out
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# LLM cheap tier — optional, used for low-stakes calls to save cost
LLM_BASE_URL_CHEAP=
LLM_API_KEY_CHEAP=
LLM_MODEL_CHEAP=

# OpenRouter — optional third LLM route
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_MODEL=

MAX_OPEN_POSITIONS=3
POSITION_CHECK_MS=10000

# v33 asymmetric runner lifecycle. PAPER learns with probe -> scale by default.
# LIVE authority remains disabled until a challenger is calibrated and approved.
RUNNER_LIFECYCLE_PAPER_ENABLED=1
RUNNER_LIFECYCLE_LIVE_ENABLED=0
PROBE_SCALE_PAPER_ENABLED=1
PROBE_SCALE_LIVE_ENABLED=0
PROBE_ENTRY_FRACTION=0.20
PROBE_VALIDATION_MIN_SECONDS=30
PROBE_VALIDATION_MAX_SECONDS=90
PROBE_CONFIRMATION_PNL_PERCENT=3
PROBE_THESIS_LOSS_PERCENT=-10
PROBE_MIN_BUYER_RATIO=0.10
RUNNER_WEAKENING_BUYER_RATIO=-0.15
CATASTROPHIC_LOSS_PERCENT=-25
CATASTROPHIC_LIQUIDITY_RETENTION=0.35

# Path models and deterministic GOOD/REJECT admission thresholds.
SURVIVAL_HORIZON_SECONDS=120
SURVIVAL_FAILURE_R=1
SURVIVAL_MODEL_MIN_SAMPLE=30
SURVIVAL_MODEL_PRIOR_STRENGTH=16
SURVIVAL_MODEL_HISTORY_LIMIT=1500
EDGE_MIN_QUALITY_SCORE=45
EDGE_MIN_SURVIVAL_PROBABILITY=0.55
EDGE_MIN_RUNNER_PROBABILITY=0.35
EDGE_MIN_EXPECTED_R=0.15
EDGE_ADMISSION_PAPER_ENABLED=1
# Keep disabled until PAPER calibration has enough route/path samples.
EDGE_ADMISSION_LIVE_ENABLED=0
SIGNAL_FANIN_WINDOW_MS=1500
LATE_EVIDENCE_WINDOW_MS=180000
RELEASE_ROLLBACK_ENABLED=0
ANGEL_RELEASE_VERSION=v33
ANGEL_PARENT_RELEASE_VERSION=v32
ANGEL_RELEASE_ROOT=/opt/angel

# Strategy Analyst/challenger guardrails. Promotion is human-approved;
# automatic rollback is PAPER-only.
CONTROL_PLANE_TEST_DAYS=14
CONTROL_PLANE_MIN_TEST_HOURS=336
CONTROL_PLANE_MIN_TEST_SAMPLE=100
CONTROL_PLANE_MIN_ROUTE_SAMPLE=30
CONTROL_PLANE_ROLLBACK_MIN_SAMPLE=30
CONTROL_PLANE_ROLLBACK_MAX_DRAWDOWN_R=5
CONTROL_PLANE_ROLLBACK_CATASTROPHIC_RATE=0.20

# PumpPortal — real-time WebSocket signal source (graduated + pre-grad tokens)
PUMPPORTAL_ENABLED=false
PUMPPORTAL_API_KEY=

# Pre-graduation scanner — catches tokens before they hit the bonding curve cap
PREGRAD_ENABLED=false
PREGRAD_POLL_MS=30000
PREGRAD_LOOKBACK_MS=7200000
PREGRAD_MAX_AGE_MS=43200000
PREGRAD_MIN_RSSR_SOL=0
PREGRAD_MAX_RSSR_SOL=100
PREGRAD_MAX_ATH_MULTIPLE=10

# Candidate floors — applied before strategy gates
MIN_HOLDERS=0
MIN_MCAP_USD=0
PUMP_FUN_GRADUATION_MCAP_USD=69000

MIN_FEE_CLAIM_SOL=2
GRADUATED_POLL_MS=30000
GRADUATED_LOOKBACK_MS=7200000
TRENDING_POLL_MS=60000
TRENDING_LOOKBACK_MS=600000
TRENDING_ENABLED=true
TRENDING_SOURCE=jupiter
TRENDING_ALLOW_DEGEN=false
TRENDING_INTERVAL=5m
TRENDING_LIMIT=100
TRENDING_ORDER_BY=volume
TRENDING_MIN_VOLUME_USD=0
TRENDING_MIN_SWAPS=0
TRENDING_MAX_RUG_RATIO=0.3
TRENDING_MAX_BUNDLER_RATE=0.5

# Axiom scraping — optional Cloudflare clearance cookie
AXIOM_CF_CLEARANCE=

# Debug helpers — leave unset in normal operation
ANGEL_GRADUATED_TEST=
ANGEL_TEST_MINT=

PORT_HEALTH=3099
ML_SERVICE_PORT=5050
